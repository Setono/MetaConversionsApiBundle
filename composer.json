{
    "name": "setono/meta-conversions-api-bundle",
    "description": "Work with the Meta / Facebook Conversions API in your Symfony application",
    "license": "MIT",
    "type": "symfony-bundle",
    "authors": [
        {
            "name": "Joachim Løvgaard",
            "email": "joachim@loevgaard.dk"
        }
    ],
    "require": {
        "php": ">=8.1",
        "composer/semver": "^3.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "setono/bot-detection-bundle": "^1.7",
        "setono/consent-contracts": "^1.1",
        "setono/meta-conversions-api-php-sdk": "^1.1",
        "symfony/config": "^6.4 || ^7.4",
        "symfony/dependency-injection": "^6.4 || ^7.4",
        "symfony/event-dispatcher": "^6.4 || ^7.4",
        "symfony/event-dispatcher-contracts": "^2.5 || ^3.0",
        "symfony/http-foundation": "^6.4 || ^7.4",
        "symfony/http-kernel": "^6.4 || ^7.4",
        "symfony/messenger": "^6.4 || ^7.4",
        "symfony/service-contracts": "^2.5 || ^3.0",
        "webmozart/assert": "^1.11"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.50",
        "matthiasnoback/symfony-dependency-injection-test": "^6.3",
        "nyholm/psr7": "^1.8",
        "nyholm/symfony-bundle-test": "^3.1",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpstan/phpstan-webmozart-assert": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.5",
        "rector/rector": "^2.4",
        "setono/consent-bundle": "^1.2",
        "setono/tag-bag": "^2.2",
        "setono/tag-bag-bundle": "^3.0",
        "shipmonk/composer-dependency-analyser": "^1.8",
        "sylius-labs/coding-standard": "^4.5",
        "symfony/framework-bundle": "^6.4 || ^7.4",
        "symfony/http-client": "^6.4 || ^7.4",
        "symfony/twig-bundle": "^6.4 || ^7.4"
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Setono\\MetaConversionsApiBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Setono\\MetaConversionsApiBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "ergebnis/composer-normalize": true,
            "php-http/discovery": false,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "analyse": "phpstan analyse",
        "check-style": "ecs check",
        "fix-style": "ecs check --fix",
        "phpunit": "phpunit"
    }
}
